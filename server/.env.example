# Copy to .env in this directory (Mail/server):
#   cp .env.example .env

# --- Postgres ---
POSTGRES_USER=mail
POSTGRES_PASSWORD=mail
POSTGRES_DB=mail
POSTGRES_HOST_PORT=12033

# --- Mail API ---
MAIL_HOST_PORT=12081
DEFAULT_PROJECT_ID=default
AUTH_ADMIN_API_KEY=dev-admin-key
AUTH_JWT_SECRET=dev-jwt-secret-shared-with-mp

# App container talks to compose service "db"
ConnectionStrings__Postgres=Host=db;Port=5432;Database=mail;Username=mail;Password=mail

# --- Prod only (docker-compose.prod.yml) ---
MAIL_IMAGE=ghcr.io/longlonggames/mail-server:1.0.0
